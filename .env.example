# ============================================================
# Nexsoll Admin API — Environment Variables
# ============================================================

# Database name must be: admin
# LOCAL example:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/admin?schema=public"

# Render External URL example:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/admin?sslmode=require&schema=public"

# Admin panel secret (x-admin-secret header)
ADMIN_SECRET="change-me-to-a-strong-secret"

PORT=3000
APP_NAME="Nexsoll Admin"
